# ---- LLM provider (any OpenAI-compatible endpoint) -------------------------
# provider: mock | openai
RESEARCHPILOT_PROVIDER=mock
MODEL=gpt-4o-mini
API_KEY=
BASE_URL=https://api.openai.com/v1
TEMPERATURE=0.2
PRESENCE_PENALTY=0.0
FREQUENCY_PENALTY=0.0
MAX_TOKENS=1200

# ---- Embeddings ------------------------------------------------------------
# hash (offline, deterministic) | openai
RESEARCHPILOT_EMBEDDING_PROVIDER=hash
RESEARCHPILOT_EMBEDDING_MODEL=text-embedding-3-small
RESEARCHPILOT_EMBEDDING_DIM=384

# ---- Runtime ---------------------------------------------------------------
RESEARCHPILOT_TOP_K=6
RESEARCHPILOT_RETRIEVE_K=12
RESEARCHPILOT_MAX_ITERATIONS=2
RESEARCHPILOT_RERANK_STRATEGY=heuristic
RESEARCHPILOT_TOOL_CACHE_TTL_S=60
RESEARCHPILOT_REQUEST_TIMEOUT_S=60
RESEARCHPILOT_MAX_RETRIES=2
RESEARCHPILOT_TOKEN_BUDGET=80000
RESEARCHPILOT_TOKEN_BUDGET_LIVE=160000
RESEARCHPILOT_KB_PATH=data/knowledge_base
RESEARCHPILOT_RUNS_PATH=runs
RESEARCHPILOT_MAX_CONTEXT_CHARS=12000
RESEARCHPILOT_PRICING_FILE=configs/pricing.yaml
RESEARCHPILOT_LOG_LEVEL=INFO

# ---- MCP -------------------------------------------------------------------
# inprocess | stdio | http
RESEARCHPILOT_MCP_TRANSPORT=inprocess
RESEARCHPILOT_MCP_URL=http://127.0.0.1:8765/mcp
RESEARCHPILOT_MCP_HOST=127.0.0.1
RESEARCHPILOT_MCP_PORT=8765
RESEARCHPILOT_MCP_TIMEOUT_S=20

# ---- Web search ------------------------------------------------------------
# offline: search the bundled corpus (deterministic, no network)
# http:    call a real search backend via RESEARCHPILOT_WEB_SEARCH_URL
RESEARCHPILOT_WEB_SEARCH_MODE=offline
RESEARCHPILOT_WEB_CORPUS_PATH=data/web_corpus
RESEARCHPILOT_WEB_SEARCH_URL=
RESEARCHPILOT_WEB_SEARCH_TIMEOUT_S=10
# optional comma-separated allow-list, e.g. api.search.example.com,search.internal
RESEARCHPILOT_WEB_SEARCH_ALLOWED_HOSTS=
